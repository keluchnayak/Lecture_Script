# ==============================================================================
# LectureScript Production & Development Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND SERVICE ENVIRONMENT VARIABLES (Render / Railway)
# ------------------------------------------------------------------------------
# Set NODE_ENV to production in hosting dashboards
NODE_ENV=production

# Server Port (Render and Railway inject this automatically at runtime)
PORT=3000

# Google Gemini AI API Key (Required for study notes and flashcard generation)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Neon PostgreSQL Pooled Connection URL (Required for backend runtime queries)
# Format: postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:your_password@ep-your-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Neon PostgreSQL Direct Connection URL (Recommended for migrations, unpooled)
# Format: postgresql://[user]:[password]@[endpoint].[region].aws.neon.tech/[dbname]?sslmode=require
DIRECT_URL=postgresql://neondb_owner:your_password@ep-your-direct.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Cryptographic Session Secret (Required for secure cookie token verification)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_long_random_session_secret_min_32_chars

# CORS Allowed Origins (Comma-separated list of allowed frontend origins)
# Include your Cloudflare Pages production URL and any custom domains
ALLOWED_ORIGINS=https://lecturescript.pages.dev,http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 2. FRONTEND CLIENT ENVIRONMENT VARIABLES (Cloudflare Pages)
# ------------------------------------------------------------------------------
# Set this in Cloudflare Pages -> Settings -> Environment Variables
# Points the React application to your Render or Railway backend API
VITE_API_BASE_URL=https://lecturescript-api.onrender.com
